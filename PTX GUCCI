-- GUCCI V3 (from XOCU) — Integrated into "Gucci" tab
-- ═══════════════════════════════════════════════════════════
local GucciV3Group = Tabs.Gucci:AddLeftGroupbox("Gucci v3", "sparkles")
do
    local gucciTypes = {
        ['Blobman']      = 'CreatureBlobman',
        ['Tractor']      = 'TractorGreen',
        ['Santa Sleigh'] = 'SantaSleigh'
    }
    local selectedGucciType = 'CreatureBlobman'
    local GUE = false
    local inexistance = {}
    local itm
    local sp
    local sv
    local humconnection
    local gucciRunning = false
    local characterAddedConnection
    local function getCharParts()
        local char = LocalPlayer.Character
        if not char then return nil, nil end
        return char:FindFirstChild('Humanoid'), char:FindFirstChild('HumanoidRootPart')
    end
    local hum2, hrp2 = getCharParts()
    local function diddle()
        if itm then
            for _, prt in pairs(itm:GetChildren()) do
                if prt:IsA('BasePart') then
                    prt.CanCollide = false
                end
            end
        end
        if hrp2 then
            hrp2.CFrame = sp
            hrp2.AssemblyLinearVelocity = sv
        end
        if hum2 then
            hum2:GetPropertyChangedSignal('SeatPart'):Once(diddle)
        end
    end
    local function checkgrab(part)
        pcall(function()
            SetNetOwner:FireServer(part, part.CFrame)
        end)
    end
    local function gucciblob()
        if gucciRunning then return end
        gucciRunning = true
        local guccion = false
        local tickyticky = tick()
        while GUE do
            hum2, hrp2 = getCharParts()
            if hum2 and hrp2 then
                local dt = tick() - tickyticky
                tickyticky = tick()
                if itm and itm:FindFirstChild('VehicleSeat') then
                    local occupant = itm.VehicleSeat.Occupant
                    if occupant and occupant ~= hum2 then
                        task.spawn(function() DestroyToy:FireServer(itm) end)
                        itm = nil
                        guccion = false
                        inexistance = {}
                        task.wait(0.1)
                        if LocalPlayer.CanSpawnToy.Value then
                            task.spawn(function()
                                SpawnToy:InvokeServer(selectedGucciType, hrp2.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0, 0, 0))
                            end)
                        end
                        task.wait()
                        continue
                    end
                end
                if itm and itm.Parent and not ((itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')) and itm:FindFirstChild('VehicleSeat') and (not itm.VehicleSeat.Occupant or itm.VehicleSeat.Occupant ~= hum2) or inexistance[itm] < 1) then
                    task.spawn(function() DestroyToy:FireServer(itm) end)
                else
                    local toyFolder = workspace:FindFirstChild(LocalPlayer.Name .. 'SpawnedInToys')
                    itm = toyFolder and toyFolder:FindFirstChild(selectedGucciType)
                end
                if not sp or not hum2.SeatPart then
                    sp = hrp2.CFrame
                    sv = hrp2.AssemblyLinearVelocity
                end
                if humconnection ~= hum2 then
                    humconnection = hum2
                    hum2:GetPropertyChangedSignal('SeatPart'):Once(diddle)
                end
                local wait = true
                if itm then
                    inexistance[itm] = (inexistance[itm] or 0) + dt
                    if (itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')) and itm:FindFirstChild('VehicleSeat') and (not itm.VehicleSeat.Occupant or itm.VehicleSeat.Occupant == hum2) then
                        if not guccion then
                            (itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')).AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end
                        local diddy = itm.VehicleSeat
                        diddy.Parent = nil
                        diddy.Parent = itm
                        if not checkgrab(itm) and (hrp2.CFrame.Position - (itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')).CFrame.Position).Magnitude < 28 then
                            for _, prt in pairs(itm:GetChildren()) do
                                if prt:IsA('BasePart') and prt.CanQuery then
                                    SetNetOwner:FireServer(prt, CFrame.lookAt(hrp2.CFrame.Position, prt.CFrame.Position))
                                end
                            end
                        end
                        if not hum2.SeatPart then
                            hum2.Sit = false
                        else
                            wait = false
                            task.wait()
                        end
                        if hrp2 and hum2 and (itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')) and itm:FindFirstChild('VehicleSeat') and (not itm.VehicleSeat.Occupant or itm.VehicleSeat.Occupant == hum2) then
                            local ragdolled = hum2:FindFirstChild('Ragdolled')
                            if ragdolled and ragdolled.Value then guccion = false end
                            if itm.VehicleSeat.Occupant == hum2 then
                                guccion = true
                            elseif not guccion then
                                task.wait()
                                wait = false
                                if (itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')) and itm:FindFirstChild('VehicleSeat') and (not itm.VehicleSeat.Occupant or itm.VehicleSeat.Occupant == hum2) then
                                    local ragdolled2 = hum2:FindFirstChild('Ragdolled')
                                    if not ragdolled2 or not ragdolled2.Value then
                                        itm.VehicleSeat:Sit(hum2)
                                        Ragdoll:FireServer(hrp2, 0.016)
                                    end
                                end
                            end
                            if guccion then
                                (itm:FindFirstChild('HumanoidRootPart') or itm:FindFirstChild('SoundPart')).AssemblyLinearVelocity = Vector3.new(0, 1e15, 0)
                            else
                                if inexistance[itm] >= game.Stats.Network.ServerStatsItem['Data Ping']:GetValue() / 250 then
                                    task.spawn(function() DestroyToy:FireServer(itm) end)
                                    hum2.Sit = true
                                end
                            end
                        end
                    else
                        if guccion then hum2.Sit = true end
                        guccion = false
                        if inexistance[itm] >= 1 then
                            task.spawn(function() DestroyToy:FireServer(itm) end)
                            if LocalPlayer.CanSpawnToy.Value then
                                task.spawn(function()
                                    SpawnToy:InvokeServer(selectedGucciType, hrp2.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0, 0, 0))
                                end)
                            end
                        end
                    end
                else
                    if guccion then guccion = false; hum2.Sit = true end
                    if LocalPlayer.CanSpawnToy.Value then
                        task.spawn(function()
                            SpawnToy:InvokeServer(selectedGucciType, hrp2.CFrame * CFrame.new(0, 100000000, 10), Vector3.new(0, 0, 0))
                        end)
                    end
                end
                if wait then
                    task.wait()
                    hum2.Sit = false
                end
            else
                task.wait()
            end
        end
        gucciRunning = false
    end
    local function onCharacterAdded(char)
        if not GUE then return end
        if itm and itm.Parent then
            task.spawn(function() DestroyToy:FireServer(itm) end)
        end
        itm = nil
        inexistance = {}
        humconnection = nil
        sp = nil
        sv = nil
        gucciRunning = false
        char:WaitForChild('Humanoid', 10)
        char:WaitForChild('HumanoidRootPart', 10)
        hum2, hrp2 = getCharParts()
        task.wait(0.5)
        task.spawn(gucciblob)
    end
    if characterAddedConnection then
        characterAddedConnection:Disconnect()
    end
    characterAddedConnection = LocalPlayer.CharacterAdded:Connect(onCharacterAdded)
    -- ═══════════ GUCCI V3 UI CONTROLS ═══════════
    GucciV3Group:AddDropdown("GucciV3Type", {
        Text = "Gucci Type",
        Values = {"Blobman", "Tractor", "Santa Sleigh"},
        Default = "Blobman",
        Callback = function(Value)
            selectedGucciType = gucciTypes[Value] or 'CreatureBlobman'
        end
    })
    GucciV3Group:AddCheckbox("GucciV3AntiGrab", {
        Text = "[GUCCI v3] Anti Grab",
        Tooltip = 'Makes you unable to be touched by anyone or anything.',
        Default = false,
        Callback = function(Value)
            GUE = Value
            if Value then
                task.spawn(gucciblob)
            else
                if itm and itm.Parent then
                    task.spawn(function() DestroyToy:FireServer(itm) end)
                end
                itm = nil
            end
        end
    })
    GucciV3Group:AddDivider()
    GucciV3Group:AddLabel("Spawn a riding toy and lock yourself\nonto it. Prevents grabs from anyone.", true)
end
