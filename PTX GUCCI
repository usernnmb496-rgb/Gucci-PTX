-- ═══════════ MenuGui Styling (same as 9rr) ═══════════
function waitFor(parent, name, recursive, timeout)
    timeout = timeout or 10
    local start = tick()
    local result = nil
    while not result and tick() - start < timeout do
        if recursive then result = parent:FindFirstChild(name, true)
        else result = parent:FindFirstChild(name) end
        if not result then task.wait(0.1) end
    end
    return result
end
